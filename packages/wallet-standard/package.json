{
	"name": "rtd-wallet-standard",
	"version": "0.19.9",
	"description": "A suite of standard utilities for implementing wallets based on the Wallet Standard.",
	"license": "Apache-2.0",
	"author": "LinkU Labs <build@linkuverse.com>",
	"type": "commonjs",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"CHANGELOG.md",
		"dist",
		"src"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LinkUVerse/rtd-ts-sdk.git"
	},
	"bugs": {
		"url": "https://github.com/LinkUVerse/rtd-ts-sdk/issues/new"
	},
	"scripts": {
		"clean": "rm -rf tsconfig.tsbuildinfo ./dist",
		"build": "build-package",
		"prettier:check": "prettier -c --ignore-unknown .",
		"prettier:fix": "prettier -w --ignore-unknown .",
		"eslint:check": "eslint --max-warnings=0 .",
		"eslint:fix": "pnpm run eslint:check --fix",
		"lint": "pnpm run eslint:check && pnpm run prettier:check",
		"lint:fix": "pnpm run eslint:fix && pnpm run prettier:fix",
		"json-schema": "typescript-json-schema src/types.ts SerializedTransactionDataV2 --required --strictNullChecks > serialized-transaction-data-v2.schema.json && prettier -w serialized-transaction-data-v2.schema.json"
	},
	"dependencies": {
		"rtd-typescript": "workspace:*",
		"@wallet-standard/core": "1.1.1"
	},
	"devDependencies": {
		"rtd-build-scripts": "workspace:*",
		"typescript": "^5.9.3",
		"typescript-json-schema": "^0.67.0"
	}
}
