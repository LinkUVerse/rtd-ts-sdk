{
	"name": "rtd-build-scripts",
	"private": true,
	"author": "LinkU Labs <build@linkuverse.com>",
	"description": "Build scripts for @linku packages",
	"version": "0.0.0",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=18"
	},
	"bin": {
		"build-package": "./src/build-package.ts",
		"build-dapp-kit": "./src/build-dapp-kit.ts"
	},
	"scripts": {
		"prettier:check": "prettier -c --ignore-unknown .",
		"prettier:fix": "prettier -w --ignore-unknown .",
		"oxlint:check": "oxlint .",
		"oxlint:fix": "oxlint --fix .",
		"lint": "pnpm run oxlint:check && pnpm run prettier:check",
		"lint:fix": "pnpm run oxlint:fix && pnpm run prettier:fix",
		"build": "tsc --build"
	},
	"devDependencies": {
		"@types/postcss-prefix-selector": "^1.16.3",
		"@vanilla-extract/esbuild-plugin": "^2.3.20",
		"autoprefixer": "^10.4.22",
		"esbuild": "^0.27.0",
		"find-up": "^7.0.0",
		"postcss": "^8.5.6",
		"postcss-prefix-selector": "^2.1.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@types/node": "^26.2.0"
	}
}
